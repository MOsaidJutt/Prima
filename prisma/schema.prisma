generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum SuperAdminRole {
  OWNER
  SUB_ADMIN
}

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SessionType {
  SUPER_ADMIN
  TENANT
}

// ─────────────────────────────────────────────────────────────────────────────
// SuperAdmin
// Platform-level only. Soft-deleted (deletedAt) to preserve PlatformAuditLog
// FK integrity when sub-admins are removed.
// No lastModifiedBy/Device — not a sync table.
// ─────────────────────────────────────────────────────────────────────────────

model SuperAdmin {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  name         String
  role         SuperAdminRole @default(SUB_ADMIN)
  permissions  String[]       @default([])
  avatar       String?
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  auditLogs PlatformAuditLog[]
  sessions  UserSession[]      @relation("SuperAdminSessions")

  @@index([deletedAt])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformSettings
// Global key-value config. No sync, no soft-delete.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSettings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformAuditLog
// Append-only. Never deleted. FK to SuperAdmin preserved via soft-delete on SA.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  superAdminId String     @db.Uuid
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization (Tenant)
// Soft-deleted so cancelled orgs preserve billing history and audit trails.
// No lastModifiedBy/Device — managed by super admin, not synced to devices.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id     String    @id @default(uuid()) @db.Uuid
  slug   String    @unique
  name   String
  status OrgStatus @default(TRIAL)

  // Contact
  email      String
  phone      String?
  website    String?
  address    String?
  city       String?
  state      String?
  country    String  @default("PK")
  postalCode String?

  // Tax / legal
  ntn  String?
  strn String?

  // Branding
  logoLight      String?
  logoDark       String?
  favicon        String?
  primaryColor   String  @default("#0F172A")
  secondaryColor String  @default("#334155")
  accentColor    String  @default("#0369A1")
  fontFamily     String  @default("Plus Jakarta Sans")

  // Locale
  currency        String @default("PKR")
  locale          String @default("en-PK")
  timezone        String @default("Asia/Karachi")
  dateFormat      String @default("DD/MM/YYYY")
  fiscalYearStart Int    @default(1)

  // Subscription
  plan              SubscriptionPlan @default(STARTER)
  trialEndsAt       DateTime?
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  nextBillingDate   DateTime?
  setupFeePaid      Boolean          @default(false)
  monthlyPrice      Decimal          @default(0) @db.Decimal(10, 2)
  customPricing     Boolean          @default(false)

  // AI
  aiEnabled          Boolean @default(false)
  aiProvider         String?
  aiApiKeyEncrypted  String?
  aiModel            String?
  embeddingProvider  String?
  monthlyTokenBudget Int     @default(100000)
  monthlyTokensUsed  Int     @default(0)
  autoTopUpEnabled   Boolean @default(false)
  autoTopUpThreshold Int     @default(10000)
  autoTopUpPackId    String?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Admin contact (set after onboarding)
  adminEmail String?
  adminName  String?

  // Billing contact
  billingEmail String?
  billingName  String?
  billingPhone String?

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices OrganizationInvoice[]
  sessions UserSession[]         @relation("TenantSessions")

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// OrganizationInvoice (Platform → Tenant billing)
// Soft-deleted to preserve financial audit trail.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationInvoice {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  issueDate   DateTime @default(now())
  dueDate     DateTime

  subscriptionFee Decimal @default(0) @db.Decimal(10, 2)
  setupFee        Decimal @default(0) @db.Decimal(10, 2)
  tokenTopUpTotal Decimal @default(0) @db.Decimal(10, 2)
  discount        Decimal @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)

  status     String    @default("DRAFT")
  paidAt     DateTime?
  paymentRef String?
  notes      String?
  pdfUrl     String?

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserSession
// Ephemeral. Hard-deleted on expiry — no soft-delete needed.
// UUID PK for consistency.
// ─────────────────────────────────────────────────────────────────────────────

model UserSession {
  id           String      @id @default(uuid()) @db.Uuid
  sessionToken String      @unique
  sessionType  SessionType

  // Super Admin session
  superAdminId String?     @db.Uuid
  superAdmin   SuperAdmin? @relation("SuperAdminSessions", fields: [superAdminId], references: [id])

  // Tenant session
  organizationId String?      @db.Uuid
  organization   Organization? @relation("TenantSessions", fields: [organizationId], references: [id])
  userId         String?       @db.Uuid

  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([sessionToken])
  @@index([superAdminId])
  @@index([organizationId, userId])
  @@index([expiresAt])
}
