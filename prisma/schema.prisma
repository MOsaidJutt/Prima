generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum SuperAdminRole {
  OWNER
  SUB_ADMIN
}

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SessionType {
  SUPER_ADMIN
  TENANT
}

// ─────────────────────────────────────────────────────────────────────────────
// SuperAdmin
// Platform-level only. Soft-deleted (deletedAt) to preserve PlatformAuditLog
// FK integrity when sub-admins are removed.
// No lastModifiedBy/Device — not a sync table.
// ─────────────────────────────────────────────────────────────────────────────

model SuperAdmin {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  name         String
  role         SuperAdminRole @default(SUB_ADMIN)
  permissions  String[]       @default([])
  avatar       String?
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  auditLogs PlatformAuditLog[]
  sessions  UserSession[]      @relation("SuperAdminSessions")

  @@index([deletedAt])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformSettings
// Global key-value config. No sync, no soft-delete.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSettings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformAuditLog
// Append-only. Never deleted. FK to SuperAdmin preserved via soft-delete on SA.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  superAdminId String     @db.Uuid
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization (Tenant)
// Soft-deleted so cancelled orgs preserve billing history and audit trails.
// No lastModifiedBy/Device — managed by super admin, not synced to devices.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id     String    @id @default(uuid()) @db.Uuid
  slug   String    @unique
  name   String
  status OrgStatus @default(TRIAL)

  // Contact
  email      String
  phone      String?
  website    String?
  address    String?
  city       String?
  state      String?
  country    String  @default("PK")
  postalCode String?

  // Tax / legal
  ntn  String?
  strn String?

  // Branding (stored as hex — converted to HSL by the layout for CSS vars)
  logoLight      String?
  logoDark       String?
  favicon        String?
  primaryColor   String  @default("#0F172A")
  secondaryColor String  @default("#334155")
  accentColor    String  @default("#0369A1")
  fontFamily     String  @default("Plus Jakarta Sans")

  // Email branding
  emailBannerUrl  String?
  emailFooterText String?

  // Login page customization
  loginCustomText String?
  loginBgImage    String?

  // Locale
  currency        String @default("PKR")
  locale          String @default("en-PK")
  timezone        String @default("Asia/Karachi")
  dateFormat      String @default("DD/MM/YYYY")
  fiscalYearStart Int    @default(1)

  // Subscription
  plan              SubscriptionPlan @default(STARTER)
  trialEndsAt       DateTime?
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  nextBillingDate   DateTime?
  setupFeePaid      Boolean          @default(false)
  monthlyPrice      Decimal          @default(0) @db.Decimal(10, 2)
  customPricing     Boolean          @default(false)

  // AI
  aiEnabled          Boolean @default(false)
  aiProvider         String?
  aiApiKeyEncrypted  String?
  aiModel            String?
  embeddingProvider  String?
  monthlyTokenBudget Int     @default(100000)
  monthlyTokensUsed  Int     @default(0)
  autoTopUpEnabled   Boolean @default(false)
  autoTopUpThreshold Int     @default(10000)
  autoTopUpPackId    String?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Admin contact (set after onboarding)
  adminEmail        String?
  adminName         String?
  // Phase 0: password hash for the org admin — nulled after Phase 1c User is created
  adminPasswordHash String?

  // Billing contact
  billingEmail String?
  billingName  String?
  billingPhone String?

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Platform relations
  invoices    OrganizationInvoice[]
  sessions    UserSession[]          @relation("TenantSessions")
  invitations OrganizationInvitation[]

  // Phase 1c tenant relations
  users            User[]
  roles            Role[]
  departments      Department[]
  userInvitations  UserInvitation[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  activityFeed     ActivityFeed[]
  invoiceTemplates InvoiceTemplate[]

  // Phase 2 relations
  productCategories     ProductCategory[]
  products              Product[]
  distributors          Distributor[]
  clients               Client[]
  warehouses            Warehouse[]
  inventoryStock        InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  attachments           Attachment[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// OrganizationInvoice (Platform → Tenant billing)
// Soft-deleted to preserve financial audit trail.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationInvoice {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  issueDate   DateTime @default(now())
  dueDate     DateTime

  subscriptionFee Decimal @default(0) @db.Decimal(10, 2)
  setupFee        Decimal @default(0) @db.Decimal(10, 2)
  tokenTopUpTotal Decimal @default(0) @db.Decimal(10, 2)
  discount        Decimal @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)

  status     String    @default("DRAFT")
  paidAt     DateTime?
  paymentRef String?
  notes      String?
  pdfUrl     String?

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// OrganizationInvitation
// Super Admin → Tenant Admin invite. Token hashed with bcrypt.
// Consumed (acceptedAt set) on first use. Expires after 48 hours.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  email       String
  tokenHash   String   @unique
  tokenPrefix String   @db.VarChar(8) // first 8 chars of raw token — pre-filter before bcrypt.compare()
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([expiresAt])
  @@index([tokenPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserSession
// Ephemeral. Hard-deleted on expiry — no soft-delete needed.
// ─────────────────────────────────────────────────────────────────────────────

model UserSession {
  id           String      @id @default(uuid()) @db.Uuid
  sessionToken String      @unique
  sessionType  SessionType

  superAdminId String?     @db.Uuid
  superAdmin   SuperAdmin? @relation("SuperAdminSessions", fields: [superAdminId], references: [id])

  organizationId String?       @db.Uuid
  organization   Organization? @relation("TenantSessions", fields: [organizationId], references: [id])
  userId         String?       @db.Uuid

  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([sessionToken])
  @@index([superAdminId])
  @@index([organizationId, userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Role
// Mutable domain table. Sync-ready.
// isSystem roles are seeded per-org and cannot be edited/deleted via UI.
// permissions: String[] validated against PERMISSION_SLUGS at write time.
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users           User[]
  userInvitations UserInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Department
// Mutable domain table. Sync-ready. Self-referential for nesting.
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?

  // Self-referential hierarchy
  parentId String?     @db.Uuid
  parent   Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DeptHierarchy")

  // Optional manager (User)
  managerId String? @db.Uuid
  manager   User?   @relation("DeptManager", fields: [managerId], references: [id])

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users           User[]
  userInvitations UserInvitation[]

  @@index([organizationId, deletedAt])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// Core tenant user. Mutable domain table. Sync-ready.
// email unique per-org: @@unique([organizationId, email]).
// passwordHash is null until the invitation is accepted.
// mfaSecret: AES-256-GCM encrypted TOTP secret (Phase 7 MFA implementation).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  email        String
  passwordHash String?
  name         String
  avatar       String?
  phone        String?

  isActive      Boolean   @default(true)
  isMfaEnabled  Boolean   @default(false)
  mfaSecret     String?   // AES-256-GCM encrypted; implementation deferred to Phase 7
  lastLoginAt   DateTime?

  // Persisted preferences: theme, notification settings, dashboard layout
  preferences Json @default("{}")

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Back-relations
  managedDepts    Department[]     @relation("DeptManager")
  sentInvitations UserInvitation[] @relation("InvitedBy")
  notifications   Notification[]
  activityFeed    ActivityFeed[]
  auditLogs       AuditLog[]       @relation("AuditUser")
  passwordResets  PasswordResetToken[]

  // Phase 2
  assignedClients       Client[]               @relation("ClientRep")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTxUser")

  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([roleId])
  @@index([departmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserInvitation
// Tenant Admin → Team Member invite. Append-only (no deletedAt).
// tokenHash: bcrypt hash of the raw token emailed to the invitee.
// ─────────────────────────────────────────────────────────────────────────────

model UserInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  email      String
  name       String?

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  invitedBy    String @db.Uuid
  invitedByUser User  @relation("InvitedBy", fields: [invitedBy], references: [id])

  tokenHash   String   @unique
  tokenPrefix String   @db.VarChar(8) // first 8 chars of raw token — pre-filter before bcrypt.compare()
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([expiresAt])
  @@index([tokenPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// PasswordResetToken
// Append-only. 1-hour expiry. usedAt set on first use.
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique
  tokenPrefix String    @db.VarChar(8) // first 8 chars of raw token — pre-filter before bcrypt.compare()
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog (Tenant-scoped)
// Append-only. No deletedAt, no lastModifiedBy.
// Captures every CREATE / UPDATE / DELETE / SUSPEND / INVITE mutation.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation("AuditUser", fields: [userId], references: [id])

  action    String  // CREATE | UPDATE | DELETE | SUSPEND | INVITE | LOGIN | BRANDING_CHANGE
  entity    String  // "User" | "Role" | "Department" | "Organization" etc.
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Always equals createdAt (append-only); required by PowerSync sync protocol

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// System-generated, user-scoped. Mutable (isRead). No lastModifiedBy.
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  type   String  // user_invited | role_changed | department_assigned | system
  title  String
  body   String
  data   Json?   // e.g. { entityId, entityType, actionUrl }

  isRead Boolean   @default(false)
  readAt DateTime?

  deletedAt DateTime? // user can dismiss a notification
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([organizationId, deletedAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ActivityFeed
// Append-only public org timeline. No deletedAt.
// ─────────────────────────────────────────────────────────────────────────────

model ActivityFeed {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  type        String
  title       String
  body        String?
  entityType  String?
  entityId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Always equals createdAt (append-only); required by PowerSync sync protocol

  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DistributorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum DistributorTier {
  GOLD
  SILVER
  BRONZE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  CHURNED
}

enum BusinessType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
  MANUFACTURER
  SERVICE
  OTHER
}

enum BusinessSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryTxType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  WRITE_OFF
  STOCK_TAKE
}

// ─────────────────────────────────────────────────────────────────────────────
// ProductCategory
// Hierarchical (parentId for nesting). Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  parentId    String?          @db.Uuid
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Product
// Full catalog entry. pgvector embedding for Phase 6 AI similarity.
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  sku           String
  barcode       String?
  name          String
  description   String?

  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  brand         String?
  unitOfMeasure String        @default("pcs")
  packSize      Int           @default(1)

  costPrice    Decimal @default(0) @db.Decimal(10, 2)
  sellingPrice Decimal @default(0) @db.Decimal(10, 2)
  mrp          Decimal? @db.Decimal(10, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)

  reorderLevel Int           @default(0)
  status       ProductStatus @default(ACTIVE)

  images String[] @default([])

  // Phase 6: pgvector embedding for AI similarity search
  embedding Unsupported("vector(1536)")?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inventoryStock        InventoryStock[]
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, sku])
  @@index([organizationId, deletedAt])
  @@index([categoryId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Distributor
// Auto-generated code per org (DST-0001). Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model Distributor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code        String
  companyName String
  contactName String?
  email       String?
  phone       String?
  phone2      String?
  website     String?

  address    String?
  city       String?
  state      String?
  country    String   @default("PK")
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  ntn  String?
  strn String?

  bankName    String?
  bankAccount String?
  bankBranch  String?
  iban        String?

  status       DistributorStatus @default(ACTIVE)
  tier         DistributorTier   @default(BRONZE)
  creditLimit  Decimal           @default(0) @db.Decimal(12, 2)
  paymentTerms Int               @default(30)

  // Computed by Phase 3 jobs
  currentBalance Decimal @default(0) @db.Decimal(12, 2)
  totalPurchases Decimal @default(0) @db.Decimal(12, 2)
  rating         Decimal @default(0) @db.Decimal(3, 1)

  tags  String[] @default([])
  notes String?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clients               Client[]
  attachments           Attachment[]           @relation("DistributorAttachments")
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([city])
}

// ─────────────────────────────────────────────────────────────────────────────
// Client
// Auto-generated code per org (CLT-0001). Linked to optional Distributor.
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code        String
  companyName String
  contactName String?
  email       String?
  phone       String?
  phone2      String?
  website     String?

  address    String?
  city       String?
  state      String?
  country    String   @default("PK")
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  ntn  String?
  strn String?

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation(fields: [distributorId], references: [id])

  assignedRepId String? @db.Uuid
  assignedRep   User?   @relation("ClientRep", fields: [assignedRepId], references: [id])

  businessType BusinessType?
  businessSize BusinessSize?
  industry     String?

  status       ClientStatus @default(ACTIVE)
  creditLimit  Decimal      @default(0) @db.Decimal(12, 2)
  paymentTerms Int          @default(30)

  // Payment behavior — computed in Phase 6
  paymentBehaviorScore Int?
  paymentBehaviorLabel String?

  // Computed financial — updated by Phase 3 jobs
  currentBalance     Decimal   @default(0) @db.Decimal(12, 2)
  totalLifetimeValue Decimal   @default(0) @db.Decimal(12, 2)
  totalOrders        Int       @default(0)
  averageOrderValue  Decimal   @default(0) @db.Decimal(12, 2)
  firstOrderDate     DateTime?
  lastOrderDate      DateTime?

  tags  String[] @default([])
  notes String?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attachments Attachment[] @relation("ClientAttachments")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([distributorId])
  @@index([assignedRepId])
  @@index([city])
}

// ─────────────────────────────────────────────────────────────────────────────
// Warehouse
// Physical storage locations. Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code      String
  name      String
  address   String?
  city      String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inventoryStock   InventoryStock[]
  transactionsFrom InventoryTransaction[] @relation("TxFromWarehouse")
  transactionsTo   InventoryTransaction[] @relation("TxToWarehouse")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// InventoryStock
// Current stock level per product per warehouse.
// ─────────────────────────────────────────────────────────────────────────────

model InventoryStock {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity    Int @default(0)
  reservedQty Int @default(0)

  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// InventoryTransaction
// Immutable audit trail of every stock movement. Append-only.
// ─────────────────────────────────────────────────────────────────────────────

model InventoryTransaction {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  fromWarehouseId String?    @db.Uuid
  fromWarehouse   Warehouse? @relation("TxFromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId String?    @db.Uuid
  toWarehouse   Warehouse? @relation("TxToWarehouse", fields: [toWarehouseId], references: [id])

  type     InventoryTxType
  quantity Int

  unitCost Decimal? @db.Decimal(10, 2)

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation(fields: [distributorId], references: [id])

  referenceType String? // "DSR" | "INVOICE" | "MANUAL" | "STOCK_TAKE"
  referenceId   String?

  reason String?
  notes  String?

  performedBy     String? @db.Uuid
  performedByUser User?   @relation("InventoryTxUser", fields: [performedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Attachment
// File uploads linked to distributors or clients. Stored in R2.
// ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation("DistributorAttachments", fields: [distributorId], references: [id])

  clientId String?  @db.Uuid
  client   Client?  @relation("ClientAttachments", fields: [clientId], references: [id])

  name      String
  fileUrl   String
  fileKey   String
  mimeType  String
  sizeBytes Int

  uploadedBy String? @db.Uuid

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId, deletedAt])
  @@index([distributorId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// InvoiceTemplate
// Structure only — full invoicing logic in Phase 3. Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  isDefault Boolean @default(false)

  headerHtml  String?
  footerHtml  String?
  logoUrl     String?
  primaryColor String?

  taxLabel             String  @default("GST")
  invoiceNumberPrefix  String  @default("INV")
  invoiceNumberPadding Int     @default(4)

  bankDetailsEnabled Boolean @default(true)
  bankDetails        Json?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, deletedAt])
}
