generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum SuperAdminRole {
  OWNER
  SUB_ADMIN
}

enum OrgStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SessionType {
  SUPER_ADMIN
  TENANT
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6: Platform Billing enums
// ─────────────────────────────────────────────────────────────────────────────

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum PaymentProviderType {
  MANUAL
  STRIPE
  JAZZCASH
  EASYPAISA
}

enum TopUpOrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PlatformPaymentType {
  SUBSCRIPTION
  SETUP_FEE
  TOPUP
  MANUAL_ADJUSTMENT
}

enum PlatformPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CouponDiscountType {
  PERCENT
  FLAT
}

enum PromotionAppliesTo {
  ALL
  ANNUAL
  NEW_SIGNUPS
}

// ─────────────────────────────────────────────────────────────────────────────
// SuperAdmin
// Platform-level only. Soft-deleted (deletedAt) to preserve PlatformAuditLog
// FK integrity when sub-admins are removed.
// No lastModifiedBy/Device — not a sync table.
// ─────────────────────────────────────────────────────────────────────────────

model SuperAdmin {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String
  name         String
  role         SuperAdminRole @default(SUB_ADMIN)
  permissions  String[]       @default([])
  avatar       String?
  isActive     Boolean        @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  auditLogs PlatformAuditLog[]
  sessions  UserSession[]      @relation("SuperAdminSessions")

  @@index([deletedAt])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformSettings
// Global key-value config. No sync, no soft-delete.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformSettings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformAuditLog
// Append-only. Never deleted. FK to SuperAdmin preserved via soft-delete on SA.
// ─────────────────────────────────────────────────────────────────────────────

model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  superAdminId String     @db.Uuid
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])

  @@index([superAdminId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization (Tenant)
// Soft-deleted so cancelled orgs preserve billing history and audit trails.
// No lastModifiedBy/Device — managed by super admin, not synced to devices.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id     String    @id @default(uuid()) @db.Uuid
  slug   String    @unique
  name   String
  status OrgStatus @default(TRIAL)

  // Contact
  email      String
  phone      String?
  website    String?
  address    String?
  city       String?
  state      String?
  country    String  @default("PK")
  postalCode String?

  // Tax / legal
  ntn  String?
  strn String?

  // Branding (stored as hex — converted to HSL by the layout for CSS vars)
  logoLight      String?
  logoDark       String?
  favicon        String?
  primaryColor   String  @default("#0F172A")
  secondaryColor String  @default("#334155")
  accentColor    String  @default("#0369A1")
  fontFamily     String  @default("Plus Jakarta Sans")

  // Email branding
  emailBannerUrl  String?
  emailFooterText String?

  // Login page customization
  loginCustomText String?
  loginBgImage    String?

  // Locale
  currency        String @default("PKR")
  locale          String @default("en-PK")
  timezone        String @default("Asia/Karachi")
  dateFormat      String @default("DD/MM/YYYY")
  fiscalYearStart Int    @default(1)

  // Subscription
  plan              SubscriptionPlan @default(STARTER)
  billingCycle      BillingCycle     @default(MONTHLY)
  trialEndsAt       DateTime?
  subscriptionStart DateTime?
  subscriptionEnd   DateTime?
  nextBillingDate   DateTime?
  setupFeePaid      Boolean          @default(false)
  monthlyPrice      Decimal          @default(0) @db.Decimal(10, 2)
  customPricing     Boolean          @default(false)

  // Phase 6: subscription lifecycle tracking
  pastDueAt          DateTime? // set when status first transitions to PAST_DUE
  suspendedAt        DateTime? // set when status first transitions to SUSPENDED
  cancelledAt        DateTime? // set when status first transitions to CANCELLED
  gracePeriodEndsAt  DateTime? // SUSPENDED + 30 days — data deletion eligible after this
  lastReminderSentAt DateTime? // last grace-period reminder email
  stripeCustomerId   String?

  // AI
  aiEnabled          Boolean @default(false)
  aiProvider         String?
  aiApiKeyEncrypted  String?
  aiModel            String?
  embeddingProvider  String?
  monthlyTokenBudget Int     @default(100000)
  monthlyTokensUsed  Int     @default(0)
  autoTopUpEnabled   Boolean @default(false)
  autoTopUpThreshold Int     @default(10000)
  autoTopUpPackId    String?

  // Onboarding
  onboardingCompleted Boolean @default(false)
  onboardingStep      Int     @default(0)

  // Admin contact (set after onboarding)
  adminEmail        String?
  adminName         String?
  // Phase 0: password hash for the org admin — nulled after Phase 1c User is created
  adminPasswordHash String?

  // Billing contact
  billingEmail String?
  billingName  String?
  billingPhone String?

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Platform relations
  invoices    OrganizationInvoice[]
  sessions    UserSession[]            @relation("TenantSessions")
  invitations OrganizationInvitation[]

  // Phase 5 AI relations
  aiSettings           OrganizationAISettings?
  aiRecommendations    AIRecommendation[]
  aiConversations      AIConversation[]
  aiInsights           AIInsight[]
  tokenWallet          TokenWallet?
  tokenUsageLogs       TokenUsageLog[]
  inventoryPredictions InventoryPrediction[]

  // Phase 6 billing relations
  paymentMethods    BillingPaymentMethod[]
  topUpOrders       TokenTopUpOrder[]
  couponRedemptions CouponRedemption[]
  platformPayments  PlatformPayment[]

  // Phase 1c tenant relations
  users            User[]
  roles            Role[]
  departments      Department[]
  userInvitations  UserInvitation[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  activityFeed     ActivityFeed[]
  invoiceTemplates InvoiceTemplate[]

  // Phase 2 relations
  productCategories     ProductCategory[]
  products              Product[]
  distributors          Distributor[]
  clients               Client[]
  warehouses            Warehouse[]
  inventoryStock        InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  attachments           Attachment[]

  // Phase 3 relations
  dsrEntries           DSREntry[]
  salesInvoices        Invoice[]
  invoicePayments      Payment[]
  paymentReminders     PaymentReminder[]
  salesTargets         SalesTarget[]
  performanceSnapshots PerformanceSnapshot[]
  invoiceNumberSeq     InvoiceNumberSequence?

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// OrganizationInvoice (Platform → Tenant billing)
// Soft-deleted to preserve financial audit trail.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationInvoice {
  id            String @id @default(uuid()) @db.Uuid
  invoiceNumber String @unique

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  issueDate   DateTime @default(now())
  dueDate     DateTime

  subscriptionFee Decimal @default(0) @db.Decimal(10, 2)
  setupFee        Decimal @default(0) @db.Decimal(10, 2)
  tokenTopUpTotal Decimal @default(0) @db.Decimal(10, 2)
  discount        Decimal @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)

  status     String    @default("DRAFT")
  paidAt     DateTime?
  paymentRef String?
  notes      String?
  pdfUrl     String?

  // Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// OrganizationInvitation
// Super Admin → Tenant Admin invite. Token hashed with bcrypt.
// Consumed (acceptedAt set) on first use. Expires after 48 hours.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  email       String
  tokenHash   String    @unique
  tokenPrefix String    @db.VarChar(8) // first 8 chars of raw token — pre-filter before bcrypt.compare()
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([expiresAt])
  @@index([tokenPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserSession
// Ephemeral. Hard-deleted on expiry — no soft-delete needed.
// ─────────────────────────────────────────────────────────────────────────────

model UserSession {
  id           String      @id @default(uuid()) @db.Uuid
  sessionToken String      @unique
  sessionType  SessionType

  superAdminId String?     @db.Uuid
  superAdmin   SuperAdmin? @relation("SuperAdminSessions", fields: [superAdminId], references: [id])

  organizationId String?       @db.Uuid
  organization   Organization? @relation("TenantSessions", fields: [organizationId], references: [id])
  userId         String?       @db.Uuid

  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([sessionToken])
  @@index([superAdminId])
  @@index([organizationId, userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Role
// Mutable domain table. Sync-ready.
// isSystem roles are seeded per-org and cannot be edited/deleted via UI.
// permissions: String[] validated against PERMISSION_SLUGS at write time.
// ─────────────────────────────────────────────────────────────────────────────

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users           User[]
  userInvitations UserInvitation[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Department
// Mutable domain table. Sync-ready. Self-referential for nesting.
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?

  // Self-referential hierarchy
  parentId String?      @db.Uuid
  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DeptHierarchy")

  // Optional manager (User)
  managerId String? @db.Uuid
  manager   User?   @relation("DeptManager", fields: [managerId], references: [id])

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users           User[]
  userInvitations UserInvitation[]
  salesTargets    SalesTarget[]    @relation("DepartmentTargets")

  @@index([organizationId, deletedAt])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// Core tenant user. Mutable domain table. Sync-ready.
// email unique per-org: @@unique([organizationId, email]).
// passwordHash is null until the invitation is accepted.
// mfaSecret: AES-256-GCM encrypted TOTP secret (Phase 7 MFA implementation).
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  email        String
  passwordHash String?
  name         String
  avatar       String?
  phone        String?

  isActive     Boolean   @default(true)
  isMfaEnabled Boolean   @default(false)
  mfaSecret    String? // AES-256-GCM encrypted; implementation deferred to Phase 7
  lastLoginAt  DateTime?

  // Phase 6: per-user AI token quota (Business+ feature, OrganizationAISettings.perUserQuotasEnabled)
  // null = unlimited (draws from org pool only)
  aiTokenQuota   Int?
  aiQuotaUsed    Int      @default(0)
  aiQuotaResetAt DateTime @default(now())

  // Persisted preferences: theme, notification settings, dashboard layout
  preferences Json @default("{}")

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Back-relations
  managedDepts    Department[]         @relation("DeptManager")
  sentInvitations UserInvitation[]     @relation("InvitedBy")
  notifications   Notification[]
  activityFeed    ActivityFeed[]
  auditLogs       AuditLog[]           @relation("AuditUser")
  passwordResets  PasswordResetToken[]

  // Phase 2
  assignedClients       Client[]               @relation("ClientRep")
  inventoryTransactions InventoryTransaction[] @relation("InventoryTxUser")

  // Phase 3
  submittedDSRs   DSREntry[]            @relation("DSRSubmittedBy")
  approvedDSRs    DSREntry[]            @relation("DSRApprovedBy")
  createdInvoices Invoice[]             @relation("InvoiceCreatedBy")
  payments        Payment[]             @relation("PaymentRecordedBy")
  salesTargets    SalesTarget[]         @relation("UserTargets")
  snapshots       PerformanceSnapshot[] @relation("UserSnapshots")

  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([roleId])
  @@index([departmentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// UserInvitation
// Tenant Admin → Team Member invite. Append-only (no deletedAt).
// tokenHash: bcrypt hash of the raw token emailed to the invitee.
// ─────────────────────────────────────────────────────────────────────────────

model UserInvitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  email String
  name  String?

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])

  invitedBy     String @db.Uuid
  invitedByUser User   @relation("InvitedBy", fields: [invitedBy], references: [id])

  tokenHash   String    @unique
  tokenPrefix String    @db.VarChar(8) // first 8 chars of raw token — pre-filter before bcrypt.compare()
  expiresAt   DateTime
  acceptedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([expiresAt])
  @@index([tokenPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// PasswordResetToken
// Append-only. 1-hour expiry. usedAt set on first use.
// ─────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  tokenHash   String    @unique
  tokenPrefix String    @db.VarChar(8) // first 8 chars of raw token — pre-filter before bcrypt.compare()
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// AuditLog (Tenant-scoped)
// Append-only. No deletedAt, no lastModifiedBy.
// Captures every CREATE / UPDATE / DELETE / SUSPEND / INVITE mutation.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation("AuditUser", fields: [userId], references: [id])

  action    String // CREATE | UPDATE | DELETE | SUSPEND | INVITE | LOGIN | BRANDING_CHANGE
  entity    String // "User" | "Role" | "Department" | "Organization" etc.
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Always equals createdAt (append-only); required by PowerSync sync protocol

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// System-generated, user-scoped. Mutable (isRead). No lastModifiedBy.
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  type  String // user_invited | role_changed | department_assigned | system
  title String
  body  String
  data  Json? // e.g. { entityId, entityType, actionUrl }

  isRead Boolean   @default(false)
  readAt DateTime?

  deletedAt DateTime? // user can dismiss a notification
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([organizationId, deletedAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ActivityFeed
// Append-only public org timeline. No deletedAt.
// ─────────────────────────────────────────────────────────────────────────────

model ActivityFeed {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  type       String
  title      String
  body       String?
  entityType String?
  entityId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Always equals createdAt (append-only); required by PowerSync sync protocol

  @@index([organizationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DistributorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum DistributorTier {
  GOLD
  SILVER
  BRONZE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  CHURNED
}

enum BusinessType {
  RETAIL
  WHOLESALE
  DISTRIBUTOR
  MANUFACTURER
  SERVICE
  OTHER
}

enum BusinessSize {
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryTxType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  WRITE_OFF
  STOCK_TAKE
}

// ─────────────────────────────────────────────────────────────────────────────
// ProductCategory
// Hierarchical (parentId for nesting). Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model ProductCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  description String?
  parentId    String?           @db.Uuid
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    ProductCategory[] @relation("CategoryHierarchy")

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  products Product[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Product
// Full catalog entry. pgvector embedding for Phase 6 AI similarity.
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  sku         String
  barcode     String?
  name        String
  description String?

  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  brand         String?
  unitOfMeasure String  @default("pcs")
  packSize      Int     @default(1)

  costPrice    Decimal  @default(0) @db.Decimal(10, 2)
  sellingPrice Decimal  @default(0) @db.Decimal(10, 2)
  mrp          Decimal? @db.Decimal(10, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)

  reorderLevel Int           @default(0)
  status       ProductStatus @default(ACTIVE)

  images String[] @default([])

  // Phase 6: pgvector embedding for AI similarity search
  embedding Unsupported("vector(1536)")?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inventoryStock        InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  dsrLineItems          DSRLineItem[]          @relation("ProductDSRLines")
  invoiceLineItems      InvoiceLineItem[]      @relation("ProductInvoiceLines")
  salesTargets          SalesTarget[]          @relation("ProductTargets")
  inventoryPredictions  InventoryPrediction[]

  @@unique([organizationId, sku])
  @@index([organizationId, deletedAt])
  @@index([categoryId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Distributor
// Auto-generated code per org (DST-0001). Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model Distributor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code        String
  companyName String
  contactName String?
  email       String?
  phone       String?
  phone2      String?
  website     String?

  address    String?
  city       String?
  state      String?
  country    String   @default("PK")
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  ntn  String?
  strn String?

  bankName    String?
  bankAccount String?
  bankBranch  String?
  iban        String?

  status       DistributorStatus @default(ACTIVE)
  tier         DistributorTier   @default(BRONZE)
  creditLimit  Decimal           @default(0) @db.Decimal(12, 2)
  paymentTerms Int               @default(30)

  // Computed by Phase 3 jobs
  currentBalance Decimal @default(0) @db.Decimal(12, 2)
  totalPurchases Decimal @default(0) @db.Decimal(12, 2)
  rating         Decimal @default(0) @db.Decimal(3, 1)

  tags  String[] @default([])
  notes String?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  clients               Client[]
  attachments           Attachment[]           @relation("DistributorAttachments")
  inventoryTransactions InventoryTransaction[]
  invoices              Invoice[]              @relation("DistributorInvoices")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([city])
}

// ─────────────────────────────────────────────────────────────────────────────
// Client
// Auto-generated code per org (CLT-0001). Linked to optional Distributor.
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code        String
  companyName String
  contactName String?
  email       String?
  phone       String?
  phone2      String?
  website     String?

  address    String?
  city       String?
  state      String?
  country    String   @default("PK")
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)

  ntn  String?
  strn String?

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation(fields: [distributorId], references: [id])

  assignedRepId String? @db.Uuid
  assignedRep   User?   @relation("ClientRep", fields: [assignedRepId], references: [id])

  businessType BusinessType?
  businessSize BusinessSize?
  industry     String?

  status       ClientStatus @default(ACTIVE)
  creditLimit  Decimal      @default(0) @db.Decimal(12, 2)
  paymentTerms Int          @default(30)

  // Payment behavior — computed in Phase 6
  paymentBehaviorScore Int?
  paymentBehaviorLabel String?

  // Computed financial — updated by Phase 3 jobs
  currentBalance     Decimal   @default(0) @db.Decimal(12, 2)
  totalLifetimeValue Decimal   @default(0) @db.Decimal(12, 2)
  totalOrders        Int       @default(0)
  averageOrderValue  Decimal   @default(0) @db.Decimal(12, 2)
  firstOrderDate     DateTime?
  lastOrderDate      DateTime?

  tags  String[] @default([])
  notes String?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  attachments  Attachment[]  @relation("ClientAttachments")
  dsrEntries   DSREntry[]    @relation("ClientDSRs")
  invoices     Invoice[]     @relation("ClientInvoices")
  salesTargets SalesTarget[] @relation("ClientTargets")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@index([status])
  @@index([distributorId])
  @@index([assignedRepId])
  @@index([organizationId, assignedRepId])
  @@index([city])
}

// ─────────────────────────────────────────────────────────────────────────────
// Warehouse
// Physical storage locations. Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  code      String
  name      String
  address   String?
  city      String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inventoryStock   InventoryStock[]
  transactionsFrom InventoryTransaction[] @relation("TxFromWarehouse")
  transactionsTo   InventoryTransaction[] @relation("TxToWarehouse")

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// InventoryStock
// Current stock level per product per warehouse.
// ─────────────────────────────────────────────────────────────────────────────

model InventoryStock {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity    Int @default(0)
  reservedQty Int @default(0)

  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// InventoryTransaction
// Immutable audit trail of every stock movement. Append-only.
// ─────────────────────────────────────────────────────────────────────────────

model InventoryTransaction {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  fromWarehouseId String?    @db.Uuid
  fromWarehouse   Warehouse? @relation("TxFromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId String?    @db.Uuid
  toWarehouse   Warehouse? @relation("TxToWarehouse", fields: [toWarehouseId], references: [id])

  type     InventoryTxType
  quantity Int

  unitCost Decimal? @db.Decimal(10, 2)

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation(fields: [distributorId], references: [id])

  referenceType String? // "DSR" | "INVOICE" | "MANUAL" | "STOCK_TAKE"
  referenceId   String?

  reason String?
  notes  String?

  performedBy     String? @db.Uuid
  performedByUser User?   @relation("InventoryTxUser", fields: [performedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────────
// Attachment
// File uploads linked to distributors or clients. Stored in R2.
// ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation("DistributorAttachments", fields: [distributorId], references: [id])

  clientId String? @db.Uuid
  client   Client? @relation("ClientAttachments", fields: [clientId], references: [id])

  name      String
  fileUrl   String
  fileKey   String
  mimeType  String
  sizeBytes Int

  uploadedBy String? @db.Uuid

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([organizationId, deletedAt])
  @@index([distributorId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────────────────────────────
// InvoiceTemplate
// Full invoicing logic in Phase 3. Sync-ready.
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceTemplate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  isDefault Boolean @default(false)

  headerHtml   String?
  footerHtml   String?
  logoUrl      String?
  primaryColor String?
  accentColor  String?

  taxLabel                 String  @default("GST")
  invoiceNumberPrefix      String  @default("INV")
  invoiceNumberPadding     Int     @default(4)
  invoiceNumberIncludeYear Boolean @default(true)

  bankDetailsEnabled Boolean @default(true)
  bankDetails        Json?

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invoices Invoice[]

  @@index([organizationId, deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// InvoiceNumberSequence
// One row per organization. Incremented atomically via UPDATE ... RETURNING to
// avoid the TOCTOU race in read-then-write sequence generation.
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceNumberSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])
  seq            Int          @default(0)
  updatedAt      DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 Enums
// ─────────────────────────────────────────────────────────────────────────────

enum DSRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum VisitType {
  IN_PERSON
  PHONE
  VIRTUAL
  EMAIL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  CARD
  WALLET
  OTHER
}

enum TargetScope {
  ORGANIZATION
  DEPARTMENT
  USER
  PRODUCT
  CLIENT
}

enum TargetType {
  REVENUE
  UNITS
  VISITS
  NEW_CLIENTS
  COLLECTIONS
}

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum ReminderChannel {
  EMAIL
  SMS
  WHATSAPP
}

// ─────────────────────────────────────────────────────────────────────────────
// DSREntry
// Daily Sales Report. Submitted by sales reps, approved by managers.
// ─────────────────────────────────────────────────────────────────────────────

model DSREntry {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  submittedById String @db.Uuid
  submittedBy   User   @relation("DSRSubmittedBy", fields: [submittedById], references: [id])

  clientId String @db.Uuid
  client   Client @relation("ClientDSRs", fields: [clientId], references: [id])

  reportDate   DateTime
  visitType    VisitType @default(IN_PERSON)
  visitNotes   String?
  outcome      String?
  followUpDate DateTime?
  satisfaction Int? // 1–5 stars

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  status DSRStatus @default(DRAFT)

  subtotal      Decimal @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal @default(0) @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal @default(0) @db.Decimal(12, 2)

  // Approval
  approvedById    String?   @db.Uuid
  approvedBy      User?     @relation("DSRApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?

  // Generated invoice (if auto-create enabled)
  invoiceId String? @db.Uuid

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lineItems DSRLineItem[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status, deletedAt])
  @@index([submittedById])
  @@index([clientId])
  @@index([status])
  @@index([reportDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// DSRLineItem
// Line items inside a DSR. Immutable after approval.
// ─────────────────────────────────────────────────────────────────────────────

model DSRLineItem {
  id         String   @id @default(uuid()) @db.Uuid
  dsrEntryId String   @db.Uuid
  dsrEntry   DSREntry @relation(fields: [dsrEntryId], references: [id])

  productId String  @db.Uuid
  product   Product @relation("ProductDSRLines", fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  discountType   String? // "PERCENT" | "FLAT"
  discountValue  Decimal? @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)

  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)

  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dsrEntryId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoice
// Full invoice lifecycle: Draft → Issued → Partially Paid → Paid / Overdue / Cancelled.
// Invoice numbers generated server-side only (offline clients cannot create numbers).
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceNumber String // server-generated; format driven by InvoiceTemplate

  clientId String @db.Uuid
  client   Client @relation("ClientInvoices", fields: [clientId], references: [id])

  distributorId String?      @db.Uuid
  distributor   Distributor? @relation("DistributorInvoices", fields: [distributorId], references: [id])

  templateId String?          @db.Uuid
  template   InvoiceTemplate? @relation(fields: [templateId], references: [id])

  dsrEntryId String? @db.Uuid // set when auto-created from approved DSR

  status InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal @default(0) @db.Decimal(12, 2)
  discountTotal  Decimal @default(0) @db.Decimal(12, 2)
  shippingAmount Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  notes String?
  terms String?

  // Email tracking
  emailSentAt   DateTime?
  openedAt      DateTime?
  trackingToken String?   @unique

  // PDF cache
  pdfUrl         String?
  pdfGeneratedAt DateTime?

  createdById String? @db.Uuid
  createdBy   User?   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]
  reminders PaymentReminder[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, deletedAt])
  @@index([organizationId, issueDate])
  @@index([clientId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([trackingToken])
}

// ─────────────────────────────────────────────────────────────────────────────
// InvoiceLineItem
// ─────────────────────────────────────────────────────────────────────────────

model InvoiceLineItem {
  id        String  @id @default(uuid()) @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  productId String?  @db.Uuid
  product   Product? @relation("ProductInvoiceLines", fields: [productId], references: [id])

  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  discountType   String?
  discountValue  Decimal? @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)

  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(10, 2)

  lineTotal Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment
// Partial payments are allowed; Invoice.paidAmount tracks cumulative total.
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod @default(CASH)

  referenceNumber String?
  bankDetails     Json?
  receiptUrl      String?
  notes           String?

  recordedById String? @db.Uuid
  recordedBy   User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, deletedAt])
  @@index([organizationId, invoiceId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// PaymentReminder
// Auto-generated by BullMQ cron. Tracks what was sent and when.
// daysOffset: negative = before due date, positive = days after due.
// ─────────────────────────────────────────────────────────────────────────────

model PaymentReminder {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  channel     ReminderChannel @default(EMAIL)
  scheduledAt DateTime
  sentAt      DateTime?
  status      String          @default("PENDING") // PENDING | SENT | FAILED

  template    String?
  messageBody String?
  daysOffset  Int // -3 = 3 days before due; +7 = 7 days overdue

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@index([scheduledAt, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// SalesTarget
// Multi-scope targets auto-updated from DSR + Invoice data via BullMQ jobs.
// ─────────────────────────────────────────────────────────────────────────────

model SalesTarget {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name   String
  scope  TargetScope
  type   TargetType
  period TargetPeriod

  userId       String?     @db.Uuid
  user         User?       @relation("UserTargets", fields: [userId], references: [id])
  departmentId String?     @db.Uuid
  department   Department? @relation("DepartmentTargets", fields: [departmentId], references: [id])
  productId    String?     @db.Uuid
  product      Product?    @relation("ProductTargets", fields: [productId], references: [id])
  clientId     String?     @db.Uuid
  client       Client?     @relation("ClientTargets", fields: [clientId], references: [id])

  targetValue   Decimal @db.Decimal(12, 2)
  achievedValue Decimal @default(0) @db.Decimal(12, 2)

  periodStart DateTime
  periodEnd   DateTime

  customPeriodLabel String?
  isActive          Boolean @default(true)

  deletedAt          DateTime?
  lastModifiedBy     String?
  lastModifiedDevice String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, deletedAt])
  @@index([scope])
  @@index([userId])
  @@index([departmentId])
  @@index([periodStart, periodEnd])
}

// ─────────────────────────────────────────────────────────────────────────────
// PerformanceSnapshot
// Daily aggregate per user, generated by BullMQ job every midnight.
// ─────────────────────────────────────────────────────────────────────────────

model PerformanceSnapshot {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String? @db.Uuid
  user   User?   @relation("UserSnapshots", fields: [userId], references: [id])

  snapshotDate DateTime

  dsrCount       Int     @default(0)
  approvedDSRs   Int     @default(0)
  rejectedDSRs   Int     @default(0)
  totalRevenue   Decimal @default(0) @db.Decimal(12, 2)
  totalInvoiced  Decimal @default(0) @db.Decimal(12, 2)
  totalCollected Decimal @default(0) @db.Decimal(12, 2)
  newClients     Int     @default(0)
  visitCount     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId, snapshotDate])
  @@index([organizationId])
  @@index([userId])
  @@index([snapshotDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — AI Intelligence Layer
// ─────────────────────────────────────────────────────────────────────────────

enum AIRecommendationType {
  DORMANT_CLIENT
  INVENTORY_REORDER
  ANOMALY_REVENUE
  ANOMALY_DSR_SKIP
  ANOMALY_VELOCITY
  ANOMALY_ORDER_SPIKE
  PAYMENT_RISK
  UPSELL
  TARGET_SUGGESTION
}

enum AIRecommendationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AIRecommendationStatus {
  ACTIVE
  ACKNOWLEDGED
  DISMISSED
  ACTED_ON
}

enum AIProviderType {
  CLAUDE
  OPENAI
  GEMINI
  OLLAMA
}

enum PaymentBehaviorLabel {
  EXCELLENT
  GOOD
  AVERAGE
  RISKY
  DEFAULTER
}

// ─────────────────────────────────────────────────────────────────────────────
// OrganizationAISettings
// Detailed AI config beyond the fields already on Organization.
// Supports per-user quotas and custom endpoint for Ollama.
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationAISettings {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Per-user quota enforcement (Business+ plan only)
  perUserQuotasEnabled Boolean @default(false)
  defaultUserQuota     Int     @default(10000) // tokens per month per user

  // Ollama custom endpoint
  ollamaBaseUrl String?

  // Embedding config
  embeddingModel String @default("text-embedding-3-small")

  // Feature flags — admin can disable specific AI features
  chatEnabled        Boolean @default(true)
  predictionsEnabled Boolean @default(true)
  summariesEnabled   Boolean @default(true)
  scoringEnabled     Boolean @default(true)
  anomalyEnabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// AIRecommendation
// Generated by background workers. Surfaced in feed + dashboards.
// ─────────────────────────────────────────────────────────────────────────────

model AIRecommendation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  type     AIRecommendationType
  severity AIRecommendationSeverity @default(INFO)
  status   AIRecommendationStatus   @default(ACTIVE)

  title   String
  body    String
  data    Json? // type-specific payload (clientId, productId, etc.)
  actions Json? // suggested action buttons [{label, url}]

  // Who this is relevant for
  targetUserId String? @db.Uuid // null = all admins
  entityType   String? // "Client" | "Product" | "User" | "Department"
  entityId     String?

  // Lifecycle
  acknowledgedAt DateTime?
  acknowledgedBy String?   @db.Uuid
  dismissedAt    DateTime?
  dismissedBy    String?   @db.Uuid
  actedOnAt      DateTime?
  actedOnBy      String?   @db.Uuid

  expiresAt DateTime?

  lastModifiedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AIConversation
// One conversation per user session. Holds all messages.
// ─────────────────────────────────────────────────────────────────────────────

model AIConversation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String @db.Uuid
  title  String @default("New Conversation")

  deletedAt      DateTime?
  lastModifiedBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  messages AIMessage[]

  @@index([organizationId, userId, deletedAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AIMessage
// Individual turn in a conversation. Append-only.
// ─────────────────────────────────────────────────────────────────────────────

model AIMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  conversation   AIConversation @relation(fields: [conversationId], references: [id])

  // Redundant but required — prevents cross-org message injection if conversationId leaks
  organizationId String @db.Uuid

  role      String // "user" | "assistant" | "tool"
  content   String
  toolCalls Json?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([organizationId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AIInsight
// Cached natural-language summaries of dashboard widgets.
// TTL: 1 hour (enforced at application level).
// ─────────────────────────────────────────────────────────────────────────────

model AIInsight {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  widgetKey String // e.g. "executive-revenue-month"
  summary   String
  dataHash  String // MD5 of the source data — invalidate if changed
  expiresAt DateTime

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, widgetKey])
  @@index([organizationId, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// TokenWallet
// One wallet per organization. Balance in tokens.
// ─────────────────────────────────────────────────────────────────────────────

model TokenWallet {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  balance        Int @default(0) // current token balance
  totalPurchased Int @default(0)
  totalConsumed  Int @default(0)

  // Rolling monthly usage (reset on 1st of each month)
  monthlyUsed    Int      @default(0)
  monthlyResetAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// TokenTopUpPack
// Admin-defined top-up options (platform-level; not per-org).
// ─────────────────────────────────────────────────────────────────────────────

model TokenTopUpPack {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  tokens      Int
  priceUsd    Decimal @db.Decimal(8, 2)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topUpOrders TokenTopUpOrder[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// TokenUsageLog
// Every AI call is appended here. Used for billing reconciliation
// and per-user quota enforcement.
// ─────────────────────────────────────────────────────────────────────────────

model TokenUsageLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId   String? @db.Uuid // null = system job
  feature  String // "chat" | "summary" | "prediction" | "scoring" | "anomaly" | "embedding"
  model    String // exact model string used
  provider String // "claude" | "openai" | "gemini" | "ollama"

  inputTokens      Int     @default(0)
  outputTokens     Int     @default(0)
  totalTokens      Int     @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 6)

  // Reference to what this call was for
  referenceType String? // "AIConversation" | "AIInsight" | "InventoryPrediction" | "AIRecommendation"
  referenceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, userId])
  @@index([organizationId, feature])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// InventoryPrediction
// Generated nightly by the demand prediction worker.
// ─────────────────────────────────────────────────────────────────────────────

model InventoryPrediction {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  // Forecasted demand
  demand30Days Decimal @db.Decimal(12, 2)
  demand60Days Decimal @db.Decimal(12, 2)
  demand90Days Decimal @db.Decimal(12, 2)

  // Reorder recommendation
  reorderQty       Int
  reorderByDate    DateTime
  stockoutRiskDate DateTime?

  // Statistical metadata
  trend       String? // "increasing" | "decreasing" | "stable"
  seasonality String? // "high" | "low" | "none"
  confidence  Decimal? @db.Decimal(3, 2) // 0.00 - 1.00

  // LLM-generated explanation
  explanation String?

  // Lifecycle
  approvedAt DateTime?
  approvedBy String?   @db.Uuid
  isApproved Boolean   @default(false)

  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, productId]) // latest prediction per product; overwritten nightly
  @@index([organizationId])
  @@index([productId])
  @@index([generatedAt])
  @@index([stockoutRiskDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6: Platform Billing models
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// BillingPlan
// Platform-defined subscription tiers (one row per SubscriptionPlan tier).
// No soft-delete — use isActive to retire a tier. Historical Organization /
// PlatformPayment records reference the SubscriptionPlan enum, not this row's
// id, so rows are never removed.
// ─────────────────────────────────────────────────────────────────────────────
model BillingPlan {
  id   String           @id @default(uuid()) @db.Uuid
  tier SubscriptionPlan @unique

  name        String
  description String?

  monthlyPrice Decimal @default(0) @db.Decimal(10, 2) // PKR
  annualPrice  Decimal @default(0) @db.Decimal(10, 2) // PKR (discounted)
  setupFee     Decimal @default(20000) @db.Decimal(10, 2) // PKR

  maxUsers             Int? // null = unlimited
  aiTokensIncluded     Int     @default(0)
  aiEnabled            Boolean @default(false)
  perUserQuotasEnabled Boolean @default(false)
  invoiceTemplateLimit Int? // null = unlimited
  customDomain         Boolean @default(false)
  prioritySupport      Boolean @default(false)
  sla                  String?

  features  Json    @default("[]") // marketing bullet points
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// BillingPaymentMethod
// Tenant's saved card on file for subscription billing & auto-top-up.
// Soft-deleted (deletedAt) so historical PlatformPayment/audit records that
// reference a removed card remain meaningful.
// ─────────────────────────────────────────────────────────────────────────────
model BillingPaymentMethod {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  provider PaymentProviderType

  providerCustomerId      String?
  providerPaymentMethodId String?

  brand    String? // visa, mastercard
  last4    String?
  expMonth Int?
  expYear  Int?

  isDefault Boolean @default(false)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([deletedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// TokenTopUpOrder
// A purchase of a TokenTopUpPack — manual, automatic, or via a payment
// provider. No soft-delete — orders are an append-only purchase ledger.
// ─────────────────────────────────────────────────────────────────────────────
model TokenTopUpOrder {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  packId String         @db.Uuid
  pack   TokenTopUpPack @relation(fields: [packId], references: [id])

  tokens   Int // snapshot
  priceUsd Decimal @db.Decimal(8, 2) // snapshot

  status       TopUpOrderStatus    @default(PENDING)
  isAutoTopUp  Boolean             @default(false)
  provider     PaymentProviderType
  providerRef  String?
  failedReason String?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Coupon
// Super Admin-defined discount codes redeemed by tenants at checkout.
// No soft-delete — use isActive to retire a code; CouponRedemption rows
// reference it permanently for revenue/analytics history.
// ─────────────────────────────────────────────────────────────────────────────
model Coupon {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  description String?

  discountType  CouponDiscountType?
  discountValue Decimal?            @db.Decimal(10, 2) // % (0-100) or flat PKR

  setupFeeWaiver Boolean @default(false)
  bonusTokens    Int     @default(0)

  applicablePlans SubscriptionPlan[] @default([])

  maxRedemptions  Int?
  redemptionCount Int  @default(0)

  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// CouponRedemption
// Append-only record of a coupon applied by an org (one redemption per org
// per coupon, enforced by the unique constraint below). Never deleted.
// ─────────────────────────────────────────────────────────────────────────────
model CouponRedemption {
  id       String @id @default(uuid()) @db.Uuid
  couponId String @db.Uuid
  coupon   Coupon @relation(fields: [couponId], references: [id])

  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  discountApplied    Decimal @default(0) @db.Decimal(10, 2)
  bonusTokensGranted Int     @default(0)
  setupFeeWaived     Boolean @default(false)

  redeemedAt DateTime @default(now())

  @@unique([couponId, organizationId])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Promotion
// Platform-wide automatic promotions (no code required), e.g. "setup waived
// for annual plans". Evaluated at checkout/plan-change time.
// No soft-delete — use isActive/startsAt/endsAt to control visibility.
// ─────────────────────────────────────────────────────────────────────────────
model Promotion {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?

  discountType   CouponDiscountType?
  discountValue  Decimal?            @db.Decimal(10, 2)
  setupFeeWaiver Boolean             @default(false)
  bonusTokens    Int                 @default(0)

  appliesTo PromotionAppliesTo @default(ALL)

  startsAt DateTime?
  endsAt   DateTime?
  isActive Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformPayment
// Append-only ledger of all platform-level payments (subscription, setup fee,
// top-ups, manual adjustments). Never deleted; status is updated only via
// reconcilePlatformPayment() / payment provider webhooks.
// ─────────────────────────────────────────────────────────────────────────────
model PlatformPayment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  type     PlatformPaymentType
  amount   Decimal             @db.Decimal(10, 2)
  currency String              @default("PKR")

  provider    PaymentProviderType
  providerRef String?

  status PlatformPaymentStatus @default(PENDING)

  invoiceId    String? @db.Uuid
  topUpOrderId String? @db.Uuid

  notes      String?
  recordedBy String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([type])
  @@index([providerRef])
}
