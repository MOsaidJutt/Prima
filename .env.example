# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Prima

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://prima:prima@localhost:5432/prima?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# Upstash Redis (rate limiting — required in production)
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─────────────────────────────────────────────────────────────────────────────
# Auth (Better Auth)
# ─────────────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# Super admin initial credentials (used only in seed)
SUPER_ADMIN_EMAIL=admin@prima.app
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ─────────────────────────────────────────────────────────────────────────────
# Encryption (AES-256-GCM for AI API keys at rest)
# ─────────────────────────────────────────────────────────────────────────────
ENCRYPTION_MASTER_KEY=change-me-to-64-hex-chars-32-bytes

# Phase 7: PII-at-rest encryption (NTN/STRN, bank account, IBAN).
# Required in production. Generate with: openssl rand -base64 32
# After setting on an existing DB, run: npx tsx scripts/encrypt-pii-backfill.ts
PII_ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Prima <noreply@prima.app>"
# Phase 7: signing secret for the Resend bounce/complaint webhook
# (Resend dashboard > Webhooks > select endpoint > Signing Secret).
# See docs/EMAIL_DELIVERABILITY.md.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────────────────────
# File Storage (Cloudflare R2)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=prima-uploads
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ─────────────────────────────────────────────────────────────────────────────
# AI Providers (tenant-level keys stored encrypted in DB; these are fallbacks)
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx
GOOGLE_AI_API_KEY=AIzaxxxx
OLLAMA_BASE_URL=http://localhost:11434

# Phase 5: AES-256-GCM master key for encrypting tenant API keys at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_ENCRYPTION_KEY=your_64_hex_char_master_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Stripe (Phase 6)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Exposed to the browser — used by the tenant billing UI to mount Stripe Elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Phase 7: on-call alert routing (src/lib/alerts.ts). Email fires whenever
# ONCALL_ALERT_EMAIL is set; Twilio WhatsApp is optional and skipped entirely
# if its vars are unset. See docs/MONITORING.md.
ONCALL_ALERT_EMAIL=oncall@prima.app
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ONCALL_WHATSAPP_TO=whatsapp:+923001234567
